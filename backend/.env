# ===================================================================
# ENVIRONMENT CONFIGURATION FOR ETHERXCHATBOT BACKEND
# ===================================================================
# Copy this file to .env and fill in the actual values
# This file documents ALL required and optional configuration

# ===================================================================
# FLASK SERVER CONFIGURATION
# ===================================================================
FLASK_HOST=0.0.0.0
FLASK_PORT=5001
FLASK_DEBUG=False                    # MUST be False in production!

# Comma-separated list of allowed frontend origins (e.g.
# https://etherx-frontend.onrender.com). Defaults to "*" (any origin) when
# unset - fine for local dev, but set explicitly in production.
CORS_ALLOWED_ORIGINS=*

# ===================================================================
# URL CONFIGURATION (needed for OAuth redirects and email links)
# ===================================================================
# Public URL of this backend (used to build OAuth redirect URIs).
# In local dev the default is fine. Set to your deployed URL in production.
BACKEND_URL=http://localhost:5001

# Public URL of the frontend (used for email links and OAuth success redirects).
FRONTEND_URL=http://localhost:5180

# ===================================================================
# GOOGLE OAUTH (Sign in with Google)
# ===================================================================
# 1. Go to https://console.cloud.google.com → APIs & Services → Credentials
# 2. Create OAuth 2.0 Client ID (Web application)
# 3. Add Authorized redirect URI: http://localhost:5001/api/auth/google/callback
#    (and your production backend URL + /api/auth/google/callback for prod)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ===================================================================
# GITHUB OAUTH (Sign in with GitHub) - optional
# ===================================================================
# 1. Go to https://github.com/settings/developers → OAuth Apps → New
# 2. Authorization callback URL: http://localhost:5001/api/auth/github/callback
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# ===================================================================
# DISCORD OAUTH (Sign in with Discord) - optional
# ===================================================================
# 1. Go to https://discord.com/developers/applications → New Application → OAuth2
# 2. Redirect URL: http://localhost:5001/api/auth/discord/callback
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here



# Per-client-IP rate limit on /api/images/generate and /api/documents/generate
# (both unauthenticated and each triggers an LLM call/disk write). Format is
# flask-limiter syntax, e.g. "10 per hour", "5 per minute".
AI_GENERATION_RATE_LIMIT=10 per hour

# Storage backend for rate-limit counters. In-memory is fine for a single
# instance; use a shared store (e.g. redis://host:6379) for multi-instance
# deployments, otherwise each instance enforces its own separate limit.
LIMITER_STORAGE_URI=memory://

# ===================================================================
# LLM PROVIDER SELECTION (CRITICAL)
# ===================================================================
# Options: "ollama_only" (Ollama only, ZERO fallback if it fails) or
# "standard" (tries DEFAULT_MODEL_KEY then DEFAULT_MODEL_FALLBACKS in order)
LLM_PROVIDER=standard

# ===================================================================
# OLLAMA CONFIGURATION
# ===================================================================
# OLLAMA_API_URL=https://ollama.com uses Ollama's hosted Cloud API (needs
# OLLAMA_API_KEY, no local model weights or GPU required) - only works for
# :cloud-tagged models. Point this at a self-hosted daemon instead
# (e.g. http://localhost:11434) if you're running your own models.
OLLAMA_ENABLED=True
OLLAMA_API_URL=https://ollama.com
OLLAMA_MODEL=nemotron-3-super:cloud
OLLAMA_API_KEY=your_ollama_cloud_api_key_here   # from ollama.com/settings/keys
OLLAMA_TIMEOUT=120                   # Seconds - increase for slower hardware

# ===================================================================
# GROQ CONFIGURATION (Cloud LLM - fallback only)
# ===================================================================
# Get API key from: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT=60

# ===================================================================
# OPENAI CONFIGURATION (Cloud LLM - fallback only)
# ===================================================================
# Get API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
OPENAI_IMAGE_MODEL=dall-e-3
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy
OPENAI_TIMEOUT=60

# ===================================================================
# IMAGE GENERATION CONFIGURATION
# ===================================================================
IMAGE_GENERATION_ENABLED=True
IMAGE_PROVIDER=auto                  # Options: runway, openai, auto
IMAGE_FALLBACK_PROVIDER_ENABLED=True
IMAGE_FALLBACK_PROVIDER_URL=https://image.pollinations.ai/prompt

# ===================================================================
# RUNWAY AI IMAGE GENERATION (Optional - for video/image generation)
# ===================================================================
# Get API key from: https://runwayml.com
RUNWAY_API_KEY=your_runway_api_key_here
RUNWAY_API_URL=https://api.dev.runwayml.com/v1
RUNWAY_MODEL=gen4_image
RUNWAY_TIMEOUT=90
RUNWAY_POLL_ATTEMPTS=8
RUNWAY_POLL_INTERVAL_SECONDS=1.5
RUNWAY_STRICT_MODE=False             # If True, only use Runway (fail if unavailable)

# ===================================================================
# SERPER WEB SEARCH (For internet queries in chat modes)
# ===================================================================
# Get API key from: https://serper.dev
SERPER_API_KEY=your_serper_api_key_here
SERPER_ENABLED=True

# ===================================================================
# NEWS API (For real-time news in chat modes)
# ===================================================================
# Get API key from: https://newsapi.org
NEWS_API_KEY=your_news_api_key_here

# ===================================================================
# DEVELOPMENT MODE (Testing without real API keys)
# ===================================================================
# IMPORTANT: Should ALWAYS be False in production!
# When True, responses are mocked (for testing only)
DEVELOPMENT_MODE=False

# ===================================================================
# MODEL ROUTING CONFIGURATION (Advanced - Optional)
# ===================================================================
# Default model to use (provider:model - provider is ollama/groq/openai)
DEFAULT_MODEL_KEY=ollama:nemotron-3-super:cloud
DEFAULT_MODEL_FALLBACKS=ollama:nemotron-3-super:cloud,groq:llama-3.1-8b-instant

# Classifier model for chat mode detection
CLASSIFIER_MODEL_KEY=ollama:nemotron-3-super:cloud
CLASSIFIER_FALLBACKS=ollama:nemotron-3-super:cloud,groq:llama-3.1-8b-instant

# Light model (fast, lower quality) for simple tasks
MODEL_PROFILE_LIGHT_KEY=ollama:nemotron-3-super:cloud
MODEL_PROFILE_LIGHT_FALLBACKS=ollama:nemotron-3-super:cloud,groq:llama-3.1-8b-instant

# Heavy model (slower, higher quality) for complex tasks
MODEL_PROFILE_HEAVY_KEY=ollama:nemotron-3-super:cloud
MODEL_PROFILE_HEAVY_FALLBACKS=ollama:nemotron-3-super:cloud,groq:llama3-70b-8192

# ===================================================================
# RAG SYSTEM CONFIGURATION (Retrieval-Augmented Generation)
# ===================================================================
RAG_ENABLED=True
RAG_UPDATE_INTERVAL=3600             # Update knowledge base every hour
RAG_EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2
RAG_FAISS_INDEX_PATH=./temp/rag_index.faiss

# ===================================================================
# LANGUAGE SUPPORT
# ===================================================================
# Supported languages for multilingual chat
SUPPORTED_LANGUAGES=en,hi,ta,te,kn   # English, Hindi, Tamil, Telugu, Kannada

# ===================================================================
# DATABASE CONFIGURATION - REQUIRED, app will not start without this
# ===================================================================
# Postgres (Supabase). No SQLite fallback - SQLite on a Render container's
# local disk isn't persistent, so it silently loses everything (every user,
# every password, every conversation) on every deploy or restart.
DATABASE_URL=sqlite:///data/chatbot.db

# ===================================================================
# JWT AUTHENTICATION
# ===================================================================
JWT_SECRET=your-super-secure-random-jwt-key-change-me-in-production
JWT_EXPIRATION_DAYS=7

# ===================================================================
# GOOGLE / GITHUB / DISCORD SIGN-IN (OAuth2)
# ===================================================================

# ===================================================================
# TRANSACTIONAL EMAIL (password reset, etc)
# ===================================================================
FRONTEND_URL=http://localhost:5180

EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID_OTP=
EMAILJS_TEMPLATE_ID_RESET=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_NAME=Pragna-1 A
